rules_version = '2';

// BLESS PRAISE Portal — paste into Firebase console → Firestore Database → Rules → Publish.
//
// Collections
//   admins/{email}        Admin list. Add documents by hand in the console (ID = lowercase email).
//   users/{uid}           Awardee profile (name, position, department).
//   applications/{id}     One per award applied for (ID = uid_award; older ones = uid): MOV files found in the Drive folder.
//   reviews/{id}          Committee decision per application: verified MOVs, status, remarks. Admins only.
//
// Monitoring
//   monitors/{email}      Staff access: hr, clinic, dll (+ subjects). Admins manage it on the site.
//   accessRequests/{email} Someone asking for Monitoring access. Admins approve or decline it.
//   personnel/{id}        Teaching and non-teaching personnel. One per account (ID = uid), made at sign-up; HR can edit.
//   attendance/{id}       Absences and tardiness. HR only.
//   aor/{week}            Cleanest classroom per week (week = Monday, YYYY-MM-DD). School Clinic only.
//   dll/{week}_{pid}      Daily Lesson Log check per teacher per week. Head/Master Teachers, own subjects.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return verified() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isSelf(uid) { return verified() && request.auth.uid == uid; }

    function reopened(uid) {
      let r = /databases/$(database)/documents/reviews/$(uid);
      return exists(r) && get(r).data.get('status', '') in ['compliance', 'incomplete'];
    }

    function awardKeys() {
      return ['cat-teach-1', 'cat-teach-2', 'cat-teach-3', 'cat-teach-4', 'cat-teach-5', 'cat-teach-6', 'cat-teach-7',
              'cat-nonteach-1', 'cat-nonteach-2', 'cat-nonteach-3', 'cat-nonteach-4',
              'cat-special-1', 'cat-special-2'];
    }

    function validApplication(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'dept', 'award', 'items', 'folder', 'checkedAt', 'submittedAt', 'endorser', 'createdAt', 'updatedAt'])
        && d.uid == uid
        && d.award in awardKeys()
        && (!('folder' in d) || (d.folder is string && d.folder.size() <= 300))
        && d.items is map
        && d.name is string && d.name.size() <= 120
        && d.dept is string && d.dept.size() <= 120;
    }

    // Teaching personnel may only apply for Teaching awards and non-teaching personnel only for
    // Non-Teaching awards (by the type on their personnel entry). Special Recognitions are open to both.
    function awardFits(uid, award) {
      let p = /databases/$(database)/documents/personnel/$(uid);
      return award.matches('cat-special-.*')
        || (exists(p) && ((award.matches('cat-teach-.*') && get(p).data.type == 'teaching')
                       || (award.matches('cat-nonteach-.*') && get(p).data.type == 'nonteaching')));
    }

    // Admin list: each user may only check their own email. Nobody writes it from the site.
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'position', 'dept', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120;
      allow delete: if false;
    }

    // One application per award: ID = <uid>_<award> (older ones use just the uid). The owner is in d.uid.
    function ownsApp(d) { return verified() && d.uid == request.auth.uid; }
    match /applications/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if ownsApp(request.resource.data) && validApplication(request.auth.uid)
        && id == request.auth.uid + '_' + request.resource.data.award
        && awardFits(request.auth.uid, request.resource.data.award);
      // Once submitted, the award is locked and files can only change if the
      // committee reopened it (Incomplete / For compliance).
      allow update: if ownsApp(resource.data) && validApplication(request.auth.uid)
        // Only older one-award applications (ID = uid) may switch award, and it must fit the person's type.
        && (request.resource.data.award == resource.data.award || (id == request.auth.uid && awardFits(request.auth.uid, request.resource.data.award)))
        && (resource.data.get('submittedAt', null) == null
            || (request.resource.data.award == resource.data.award
                && (request.resource.data.items == resource.data.items || reopened(id))));
      // Teachers can remove an award they haven't submitted; admins can delete any application.
      allow delete: if isAdmin() || (ownsApp(resource.data) && resource.data.get('submittedAt', null) == null);
    }

    match /reviews/{id} {
      allow read: if isAdmin() || (verified() && (id == request.auth.uid || id.matches(request.auth.uid + '_cat-[a-z]+-[0-9]+')));
      allow write: if isAdmin();
    }

    // ---------- Monitoring ----------
    function subjects() {
      return ['English', 'Math', 'Science', 'Filipino', 'Araling Panlipunan', 'TLE', 'Values Education', 'MAPEH'];
    }
    function monitorPath() { return /databases/$(database)/documents/monitors/$(request.auth.token.email); }
    function isMonitor() { return verified() && exists(monitorPath()); }
    // can('hr'), can('clinic'), can('dll'): admins can do everything.
    function can(role) { return isAdmin() || (isMonitor() && get(monitorPath()).data.get(role, false) == true); }
    function mySubject(s) {
      return s in subjects() && (isAdmin() || (can('dll') && s in get(monitorPath()).data.get('subjects', [])));
    }
    function isDay(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function str(v, max) { return v is string && v.size() <= max; }

    match /monitors/{email} {
      allow get: if (signedIn() && request.auth.token.email == email) || isAdmin();
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'hr', 'clinic', 'dll', 'subjects', 'by', 'updatedAt'])
        && str(request.resource.data.name, 120)
        && request.resource.data.hr is bool && request.resource.data.clinic is bool && request.resource.data.dll is bool
        && request.resource.data.subjects is list && request.resource.data.subjects.hasOnly(subjects());
    }

    // Someone asking for Monitoring access (at sign-up or later). Only for their own email;
    // nothing is granted until an admin approves it into monitors/{email}.
    match /accessRequests/{email} {
      allow get: if (signedIn() && request.auth.token.email == email) || isAdmin();
      allow list: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow create, update: if signedIn() && request.auth.token.email == email
        && request.resource.data.keys().hasOnly(['name', 'email', 'position', 'hr', 'clinic', 'dll', 'subjects', 'createdAt'])
        && request.resource.data.email == email
        && str(request.resource.data.name, 120) && str(request.resource.data.position, 120)
        && request.resource.data.hr is bool && request.resource.data.clinic is bool && request.resource.data.dll is bool
        && request.resource.data.subjects is list && request.resource.data.subjects.hasOnly(subjects());
    }

    function validPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'type', 'subject', 'office', 'position', 'email', 'by', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.type in ['teaching', 'nonteaching']
        && (d.subject == '' || d.subject in subjects())
        && str(d.get('office', ''), 80)
        && str(d.position, 120)
        && str(d.get('email', ''), 200);
    }
    // Each account keeps its own entry (ID = uid) from sign-up and My profile.
    function ownPerson(id) {
      return isOwner(id) && request.resource.data.get('email', '') == request.auth.token.email;
    }

    match /personnel/{id} {
      allow read: if can('hr') || can('dll') || isOwner(id);
      allow create, update: if validPerson() && (can('hr') || ownPerson(id));
      allow delete: if can('hr');
    }

    match /attendance/{id} {
      allow read, delete: if can('hr');
      allow create, update: if can('hr')
        && request.resource.data.keys().hasOnly(['pid', 'name', 'ptype', 'type', 'date', 'kind', 'duration', 'timeIn', 'minutes', 'remarks', 'by', 'createdAt', 'updatedAt'])
        && request.resource.data.pid is string
        && str(request.resource.data.name, 120)
        && request.resource.data.type in ['absent', 'late', 'uniform']
        && isDay(request.resource.data.date)
        && str(request.resource.data.kind, 80)
        && request.resource.data.duration in ['', 'whole', 'am', 'pm']
        && str(request.resource.data.timeIn, 5)
        && request.resource.data.minutes is int && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 600
        && str(request.resource.data.remarks, 500);
    }

    match /aor/{week} {
      allow read, delete: if can('clinic');
      allow create, update: if can('clinic')
        && request.resource.data.keys().hasOnly(['week', 'first', 'second', 'third', 'remarks', 'by', 'updatedAt'])
        && request.resource.data.week == week && isDay(week)
        && request.resource.data.first is string && request.resource.data.first.size() > 0 && request.resource.data.first.size() <= 80
        && str(request.resource.data.second, 80) && str(request.resource.data.third, 80)
        && str(request.resource.data.remarks, 300);
    }

    match /dll/{id} {
      allow read: if can('dll');
      allow create, update: if mySubject(request.resource.data.subject)
        && request.resource.data.keys().hasOnly(['week', 'pid', 'name', 'subject', 'status', 'remarks', 'by', 'updatedAt'])
        && isDay(request.resource.data.week)
        && id == request.resource.data.week + '_' + request.resource.data.pid
        && str(request.resource.data.name, 120)
        && request.resource.data.status in ['ontime', 'late', 'missing']
        && str(request.resource.data.remarks, 300);
      allow delete: if mySubject(resource.data.subject);
    }
  }
}
